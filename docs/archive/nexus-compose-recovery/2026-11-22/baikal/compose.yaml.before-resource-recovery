services:
  baikal-baikal-1:
    image: ckulka/baikal:0.10.1@sha256:658e9582f8d418392b4dfe7e816835b003694c8cb54ed0ba598eb5727b58fe22
    pull_policy: never
    container_name: baikal-baikal-1
    restart: always
    env_file:
    - path: /etc/nexus/secrets/baikal-baikal-1/baikal-baikal-1.env
      format: raw
    volumes:
    - type: bind
      source: /srv/containers/data/baikal/data
      target: /var/www/baikal/Specific
      read_only: false
      bind:
        create_host_path: false
    - type: bind
      source: /srv/containers/data/baikal/config
      target: /var/www/baikal/config
      read_only: false
      bind:
        create_host_path: false
    shm_size: 67108864
    mem_limit: 67108864
    cpus: 0.25
    networks:
      docker-vlan:
        ipv4_address: 192.168.5.42
        gw_priority: 300
        mac_address: 9e:d3:97:8b:c8:44
      proxy-backend:
        aliases:
        - baikal-baikal-1
        ipv4_address: 172.16.11.30
        mac_address: 3e:f4:bc:1e:56:e8
    healthcheck:
      test:
      - CMD
      - /usr/bin/curl
      - -fsS
      - --max-time
      - '4'
      - http://127.0.0.1:80/
      interval: 30s
      timeout: 6s
      retries: 5
      start_period: 90s
    dns:
    - 1.1.1.1
networks:
  docker-vlan:
    external: true
  proxy-backend:
    external: true
  nexus-egress:
    external: true
