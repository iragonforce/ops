#!/usr/bin/env python3

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Perform the fixed privileged power-off action accepted by the existing SSH policy.\nUsage: homelab-power-action  [ARGUMENT ...]\n\nSource: shared/scripts/power-action in ~/ops\nSee man homelab-power-action for the existing call sites and argument handling.')
        raise SystemExit(0)
# Perform the fixed privileged power-off action accepted by the existing SSH policy. See homelab-power-action(1) for source and integration details.
import os,subprocess,sys
if os.geteuid()!=0:sys.exit('This fixed power action needs its installed permission rule.')
if sys.argv[1:]!=['off']:sys.exit('Only the fixed off action is permitted.')
if sys.platform=='darwin':
    sys.exit(subprocess.run(['/usr/bin/pmset','sleepnow']).returncode)
sys.exit(subprocess.run(['/usr/bin/systemctl','poweroff','--no-block']).returncode)
