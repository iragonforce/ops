#!/usr/bin/env bash
# Toggle the retained tmux relay control state. See tmux-relay-toggle-control(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Toggle the retained tmux relay control state.
Usage: tmux-relay-toggle-control 

Source: shared/scripts/tmux-relay-toggle-control in ~/ops
See man tmux-relay-toggle-control for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi
set -euo pipefail

tmux_bin="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"

if [[ -z "$tmux_bin" && -x /usr/bin/tmux ]]; then
  tmux_bin=/usr/bin/tmux
fi

if [[ -z "$tmux_bin" && -x /opt/homebrew/bin/tmux ]]; then
  tmux_bin=/opt/homebrew/bin/tmux
fi

if [[ -z "$tmux_bin" ]]; then
  exit 127
fi

session_name="$("$tmux_bin" display-message -p '#S' 2>/dev/null || true)"
window_index="$("$tmux_bin" display-message -p '#I' 2>/dev/null || true)"
window_name="$("$tmux_bin" display-message -p '#W' 2>/dev/null || true)"

if [[ -z "$session_name" || -z "$window_index" ]]; then
  exit 0
fi

target="${session_name}:${window_index}"
relay_flag="$("$tmux_bin" show-window-options -v -t "$target" @relay_window 2>/dev/null || true)"

if [[ "$relay_flag" != "on" ]]; then
  exit 0
fi

relay_control="$("$tmux_bin" show-window-options -v -t "$target" @relay_control 2>/dev/null || printf 'inner')"

if [[ "$relay_control" == "outer" ]]; then
  "$tmux_bin" set-window-option -t "$target" -q @relay_control inner
  "$HOME/.local/bin/tmux-relay-inner-status" on >/dev/null 2>&1 || true
  "$HOME/.local/bin/tmux-refresh-status" >/dev/null 2>&1 || true
  "$tmux_bin" display-message "relay: ${window_name:-inner} controls display"
else
  "$tmux_bin" set-window-option -t "$target" -q @relay_control outer
  "$HOME/.local/bin/tmux-relay-inner-status" off >/dev/null 2>&1 || true
  "$HOME/.local/bin/tmux-refresh-status" >/dev/null 2>&1 || true
  "$tmux_bin" display-message "relay: ${session_name:-outer} controls display"
fi
