#!/usr/bin/env bash
# Invoke the host-specific Tensor power shortcut; interfaces differ between deployments. See tensor(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Invoke the host-specific Tensor power shortcut; interfaces differ between deployments.
Usage: tensor  [ARGUMENT ...]
echo "Usage: tensor {poweron|poweroff|reboot|status}"
Source: hosts/nexus/files/.local/bin/power-tensor in ~/ops
See man tensor for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi

HOST="tensor"
MAC="bc:fc:e7:6f:95:42"
BROADCAST="192.168.1.255"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=2)

is_up() {
    ssh "${SSH_OPTS[@]}" "$HOST" true &>/dev/null
}

boot_id() {
    ssh "${SSH_OPTS[@]}" "$HOST" \
        'cat /proc/sys/kernel/random/boot_id' 2>/dev/null
}

wait_down() {
    local start=$SECONDS

    while (( SECONDS - start < 90 )); do
        if ! is_up; then
            echo "tensor is down"
            return 0
        fi
        sleep 2
    done

    echo "Timeout waiting for tensor to go down" >&2
    return 1
}

wait_up() {
    local old_id="${1:-}"
    local start=$SECONDS
    local current_id

    while (( SECONDS - start < 180 )); do
        current_id=$(boot_id)

        if [[ -n "$current_id" && "$current_id" != "$old_id" ]]; then
            echo "tensor is up"
            return 0
        fi

        sleep 2
    done

    echo "Timeout waiting for tensor to come up" >&2
    return 1
}

case "${1:-}" in
    poweron)
        if is_up; then
            echo "tensor is up"
            exit 0
        fi

        wakeonlan -i "$BROADCAST" "$MAC" >/dev/null || exit 1
        wait_up
        ;;

    poweroff)
        if ! is_up; then
            echo "tensor is down"
            exit 0
        fi

        ssh "${SSH_OPTS[@]}" "$HOST" \
            'sudo -n systemctl poweroff' >/dev/null 2>&1 || true

        wait_down
        ;;

    reboot)
        OLD_ID=$(boot_id)
        [[ -n "$OLD_ID" ]] || exit 1

        ssh "${SSH_OPTS[@]}" "$HOST" \
            'sudo -n systemctl reboot' >/dev/null 2>&1 || true

        wait_down || exit 1
        wait_up "$OLD_ID"
        ;;

    status)
        if is_up; then
            echo "tensor is up"
        else
            echo "tensor is down"
        fi
        ;;

    *)
        echo "Usage: tensor {poweron|poweroff|reboot|status}"
        exit 1
        ;;
esac
