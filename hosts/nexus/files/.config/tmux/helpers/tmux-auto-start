#!/usr/bin/env bash
# Attach the canonical host tmux session, creating missing layout windows only. See tmux-auto-start(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Attach the canonical host tmux session, creating missing layout windows only.
Usage: tmux-auto-start 

Source: hosts/nexus/files/.config/tmux/helpers/tmux-auto-start in ~/ops
See man tmux-auto-start for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi

set -euo pipefail
tmux_bin="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"

if [[ -z "$tmux_bin" && -x /usr/bin/tmux ]]; then
  tmux_bin=/usr/bin/tmux
fi

if [[ -z "$tmux_bin" && -x /opt/homebrew/bin/tmux ]]; then
  tmux_bin=/opt/homebrew/bin/tmux
fi

if [[ -z "$tmux_bin" ]]; then
  printf 'tmux is not available\n' >&2
  exit 127
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  exit 0
fi

if [[ -n "${TMUX:-}" ]]; then
  exit 0
fi

if [[ "${TERM:-}" == "dumb" ]]; then
  exit 0
fi

if [[ -n "${SSH_ORIGINAL_COMMAND:-}" || -n "${ZSH_EXECUTION_STRING:-}" ]]; then
  exit 0
fi

case "$(hostname -s)" in
  tensor) session_name=1 ;;
  nexus) session_name=nexus ;;
  *) session_name=main ;;
esac

if ! "$tmux_bin" has-session -t "$session_name" 2>/dev/null; then
  "$HOME/.local/bin/tmux-bootstrap-session" "$session_name" "$PWD"
fi
"$HOME/.local/bin/tmux-ensure-layout" "$session_name" "$PWD"
if [[ -z "$("$tmux_bin" list-clients -t "$session_name" -F '#{client_pid}')" ]]; then
  "$tmux_bin" select-window -t "${session_name}:1"
fi

if [[ -n "${TMUX_RELAY_CHAIN:-}" ]]; then
  "$tmux_bin" set-option -t "$session_name" -q @relay_chain "$TMUX_RELAY_CHAIN"
elif [[ -z "${SSH_CONNECTION:-}" ]]; then
  "$tmux_bin" set-option -tu "$session_name" @relay_chain >/dev/null 2>&1 || true
fi

if [[ -n "${TMUX_AUTO_EXIT_ON_DETACH:-}" ]]; then
  "$tmux_bin" set-option -t "$session_name" -q @auto_unwind on
else
  "$tmux_bin" set-option -t "$session_name" -q @auto_unwind off
fi

"$tmux_bin" attach-session -t "$session_name"
