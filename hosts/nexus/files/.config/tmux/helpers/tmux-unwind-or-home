#!/usr/bin/env bash
# Return through the existing tmux SSH chain or home session. See tmux-unwind-or-home(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Return through the existing tmux SSH chain or home session.
Usage: tmux-unwind-or-home 

Source: hosts/nexus/files/.config/tmux/helpers/tmux-unwind-or-home in ~/ops
See man tmux-unwind-or-home for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi

set -euo pipefail

tmux_bin="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"

if [[ -z "$tmux_bin" && -x /usr/bin/tmux ]]; then
  tmux_bin=/usr/bin/tmux
fi

if [[ -z "$tmux_bin" && -x /opt/homebrew/bin/tmux ]]; then
  tmux_bin=/opt/homebrew/bin/tmux
fi

if [[ -z "$tmux_bin" ]]; then
  exit 0
fi

session_name="$("$tmux_bin" display-message -p '#S' 2>/dev/null || true)"
auto_unwind="off"

if [[ -n "$session_name" ]]; then
  auto_unwind="$("$tmux_bin" show-options -v -t "$session_name" @auto_unwind 2>/dev/null || printf 'off')"
fi

if [[ "$auto_unwind" == "on" ]]; then
  "$tmux_bin" detach-client >/dev/null 2>&1 || true
else
  if [[ -n "$session_name" ]]; then
    "$tmux_bin" select-window -t "${session_name}:1" >/dev/null 2>&1 || true
  fi
fi

exit 0
