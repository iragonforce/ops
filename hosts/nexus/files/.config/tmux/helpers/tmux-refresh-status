#!/usr/bin/env bash
# Provide the retained compatibility entry point without global status mutation. See tmux-refresh-status(1) for source and integration details.
if [ "${1-}" = '--help' ] && [ "$#" -eq 1 ]; then
  cat <<'OPS_USAGE_TEXT'
Provide the retained compatibility entry point without global status mutation.
Usage: tmux-refresh-status 

Source: hosts/nexus/files/.config/tmux/helpers/tmux-refresh-status in ~/ops
See man tmux-refresh-status for the existing call sites and argument handling.
OPS_USAGE_TEXT
  exit 0
fi
set -euo pipefail

tmux_bin="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"

if [[ -z "$tmux_bin" && -x /usr/bin/tmux ]]; then
  tmux_bin=/usr/bin/tmux
fi

if [[ -z "$tmux_bin" && -x /opt/homebrew/bin/tmux ]]; then
  tmux_bin=/opt/homebrew/bin/tmux
fi

if [[ -z "$tmux_bin" ]]; then
  exit 127
fi

current_session="$("$tmux_bin" display-message -p '#S' 2>/dev/null || true)"
current_name="$("$tmux_bin" display-message -p '#W' 2>/dev/null || true)"
current_index="$("$tmux_bin" display-message -p '#I' 2>/dev/null || true)"

relay_flag="off"
relay_control="inner"

if [[ -n "$current_session" && -n "$current_index" ]]; then
  relay_flag="$("$tmux_bin" show-window-options -v -t "${current_session}:${current_index}" @relay_window 2>/dev/null || true)"
  relay_control="$("$tmux_bin" show-window-options -v -t "${current_session}:${current_index}" @relay_control 2>/dev/null || printf 'inner')"
fi

primary_prefix="$("$tmux_bin" show-options -gv @primary_prefix 2>/dev/null || printf 'C-b')"
primary_prefix2="$("$tmux_bin" show-options -gv @primary_prefix2 2>/dev/null || true)"

copy_managed="$("$tmux_bin" show-options -gqv @tmux-copy-enabled 2>/dev/null || true)"

if [[ "$relay_flag" == "on" && "$relay_control" == "inner" && "$copy_managed" != "on" ]]; then
  "$HOME/.local/bin/tmux-relay-inner-status" on >/dev/null 2>&1 || true
  "$tmux_bin" set-option -g status off >/dev/null
  "$tmux_bin" set-option -g prefix "$primary_prefix" >/dev/null
  "$tmux_bin" set-option -gu prefix2 >/dev/null 2>&1 || true
else
  if [[ "$relay_flag" == "on" ]]; then
    "$HOME/.local/bin/tmux-relay-inner-status" off >/dev/null 2>&1 || true
  fi

  if [[ "$copy_managed" == "on" ]]; then
    "$tmux_bin" set-option -g status on >/dev/null
  else
    "$tmux_bin" set-option -g status on >/dev/null
  fi

  "$tmux_bin" set-option -g prefix "$primary_prefix" >/dev/null

  if [[ -n "$primary_prefix2" ]]; then
    "$tmux_bin" set-option -g prefix2 "$primary_prefix2" >/dev/null
  else
    "$tmux_bin" set-option -gu prefix2 >/dev/null 2>&1 || true
  fi
fi
