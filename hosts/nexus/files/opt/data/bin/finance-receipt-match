#!/usr/bin/env python3
# Purpose: Suggest unique validated receipt-to-Wealthfolio spending links in existing analytics tables.
# Inputs: --preview (default) or --apply; finance analytics PostgreSQL and read-scoped Wealthfolio MCP key.
# Outputs: Aggregate counts only; candidate bank snapshots and receipt links on --apply (never confirmed).
# Dependencies: Python 3.9+, Docker/psql, systemd-creds, bws, /usr/local/sbin/receipt-match-audit MCP helper.
# Side effects: --apply adds only one-to-one candidate rows; does not create or edit Wealthfolio expenses.
# Safety: Exact CAD amount, close date, strong merchant and unique ownership; ambiguity/drift fails closed.
#         Require protected analytics backup before apply; rollback only reviewed candidate rows.
"""Idempotently stage receipt-to-bank candidate links without asserting a complete budget."""
import argparse
import collections
import csv
from datetime import date, timedelta
from decimal import Decimal, InvalidOperation
from difflib import SequenceMatcher
import io
import json
import os
import re
import runpy
import subprocess
import sys
import unicodedata

ANALYTICS_DB = ['docker', 'exec', 'finance-analytics-db', 'psql', '-X', '-A', '-t',
                '-v', 'ON_ERROR_STOP=1', '-U', 'finance_analytics', '-d', 'finance_analytics']
RECEIPTS_QUERY = """SELECT COALESCE(json_agg(json_build_object(
 'id',id,'source',source,'merchant',merchant,'date',purchase_date,
 'total_cents',total_cents) ORDER BY id),'[]'::json)::text
 FROM purchase_receipts WHERE status='validated' AND duplicate_of_id IS NULL AND currency='CAD';"""
MATCHES_QUERY = """SELECT COALESCE(json_agg(json_build_object(
 'receipt_id',receipt_id,'activity_id',activity_id,'match_state',match_state,
 'match_method',match_method) ORDER BY receipt_id),'[]'::json)::text
 FROM receipt_transaction_matches;"""
SNAPSHOTS_QUERY = """SELECT COALESCE(json_agg(json_build_object(
 'activity_id',activity_id,'bank_date',bank_date,'merchant_description',merchant_description,
 'account_id',account_id,'account_name',account_name,'activity_type',activity_type,
 'currency',currency,'cash_flow_bucket',cash_flow_bucket,
 'visible_spending_cents',visible_spending_cents) ORDER BY activity_id),'[]'::json)::text
 FROM bank_activity_snapshot;"""


def normalized(value):
    text = unicodedata.normalize('NFKD', str(value or '')).casefold()
    text = ''.join(char for char in text if not unicodedata.combining(char))
    return ' '.join(re.findall(r'[a-z0-9]+', text))


def strong_merchant(left, right):
    a, b = normalized(left), normalized(right)
    return bool(a and b and (a == b or (len(a) >= 5 and a in b)
                or (len(b) >= 5 and b in a)
                or SequenceMatcher(None, a, b).ratio() >= 0.84))


def bank_cents(value):
    try:
        amount = Decimal(str(value))
        if (not amount.is_finite() or amount <= 0
                or amount != amount.quantize(Decimal('0.01'))):
            return None
        return int(amount * 100)
    except (InvalidOperation, ValueError, TypeError):
        return None


def choose_unique_matches(receipts, activities):
    """Keep only strict one-to-one candidates; never infer an unmatched bank expense."""
    activities = {row['id']: row for row in activities}
    proposed = {}
    ambiguous = set()
    for receipt in receipts:
        day = date.fromisoformat(str(receipt['date'])[:10])
        matches = []
        for activity in activities.values():
            if (activity['activityType'] != 'WITHDRAWAL' or activity['currency'] != 'CAD'
                    or bank_cents(activity['amount']) != receipt['total_cents']
                    or abs((day - date.fromisoformat(activity['date'][:10])).days) > 3
                    or not strong_merchant(receipt['merchant'], activity.get('notes'))):
                continue
            matches.append(activity)
        if len(matches) == 1:
            proposed[receipt['id']] = (receipt, matches[0])
        elif matches:
            ambiguous.add(receipt['id'])
    owners = collections.Counter(a['id'] for _r, a in proposed.values())
    links = []
    for ident, (receipt, activity) in proposed.items():
        if owners[activity['id']] != 1:
            ambiguous.add(ident)
            continue
        links.append({'receipt_id': receipt['id'], 'activity_id': activity['id'],
                      'bank_date': activity['date'][:10],
                      'merchant_description': activity.get('notes') or '',
                      'account_id': activity['accountId'],
                      'account_name': activity.get('accountName') or '',
                      'activity_type': activity['activityType'],
                      'currency': activity['currency'],
                      'visible_spending_cents': bank_cents(activity['amount'])})
    return {'links': links, 'candidate_count': len(links),
            'ambiguous_count': len(ambiguous),
            'unmatched_count': len(receipts) - len(links) - len(ambiguous)}


def classify_existing(existing, link):
    if existing is None:
        return 'new'
    if existing['match_state'] != 'candidate':
        return 'preserve'
    if existing['activity_id'] != link['activity_id']:
        raise ValueError('Existing candidate points elsewhere; review required')
    return 'already'


def reject_stale_candidates(receipts, existing_matches, selected):
    """Fail closed if a previously staged candidate no longer matches live evidence."""
    current = {row['receipt_id'] for row in selected['links']}
    if any(row['match_state'] == 'candidate'
           and row['match_method'] == 'unique_amount_merchant_near_date_v1'
           and row['receipt_id'] not in current for row in existing_matches):
        raise ValueError('Existing candidate no longer satisfies matching evidence')


def snapshot_matches(existing, link):
    return (existing['activity_id'] == link['activity_id']
            and existing['bank_date'] == link['bank_date']
            and existing['merchant_description'] == link['merchant_description']
            and existing['account_id'] == link['account_id']
            and existing['account_name'] == link['account_name']
            and existing['activity_type'] == link['activity_type']
            and existing['currency'] == link['currency']
            and existing['cash_flow_bucket'] == 'spending'
            and existing['visible_spending_cents'] == link['visible_spending_cents'])


def build_insert_script(links):
    """COPY JSON through psql stdin, atomically insert new snapshots and candidate links."""
    stream = io.StringIO(newline='')
    writer = csv.writer(stream, lineterminator='\n')
    for link in links:
        writer.writerow([json.dumps(link, ensure_ascii=True, separators=(',', ':'))])
    if any('\n' in line[:-1] for line in stream.getvalue().splitlines(keepends=True)):
        raise ValueError('Multiline payload not supported')
    return ("BEGIN;\nCREATE TEMP TABLE incoming (payload jsonb) ON COMMIT DROP;\n"
            "COPY incoming (payload) FROM STDIN WITH (FORMAT csv);\n"
            + stream.getvalue() + "\\.\n" + """INSERT INTO bank_activity_snapshot
 (activity_id,bank_date,merchant_description,account_id,account_name,
  activity_type,currency,cash_flow_bucket,visible_spending_cents,source_data)
SELECT (p.payload->>'activity_id')::uuid,(p.payload->>'bank_date')::date,
 p.payload->>'merchant_description',(p.payload->>'account_id')::uuid,
 p.payload->>'account_name',p.payload->>'activity_type','CAD','spending',
 (p.payload->>'visible_spending_cents')::bigint,
 jsonb_build_object('parser','finance-receipt-match-v1','scope','candidate_only')
FROM incoming p ON CONFLICT (activity_id) DO NOTHING;
INSERT INTO receipt_transaction_matches
 (receipt_id,activity_id,match_state,match_method,confidence)
SELECT (p.payload->>'receipt_id')::bigint,(p.payload->>'activity_id')::uuid,
 'candidate','unique_amount_merchant_near_date_v1',NULL
FROM incoming p ON CONFLICT (receipt_id) DO NOTHING;
COMMIT;
""")


def query_json(query):
    result = subprocess.run(ANALYTICS_DB + ['-c', query],
                            capture_output=True, text=True, timeout=45)
    if result.returncode:
        raise RuntimeError('Analytics read failed')
    return json.loads(result.stdout.strip())


def analytics_write_command():
    return ANALYTICS_DB[:2] + ['-i'] + ANALYTICS_DB[2:] + ['-q']


def credential():
    token = subprocess.run(['/usr/bin/systemd-creds', 'decrypt', '--name=bws-access-token',
                            '/etc/credstore.encrypted/bws-access-token', '-'],
                           capture_output=True, text=True, check=True, timeout=30).stdout.strip()
    env = {**os.environ, 'BWS_ACCESS_TOKEN': token}
    listed = json.loads(subprocess.run(['/usr/local/bin/bws', 'secret', 'list', '--output', 'json'],
                                       capture_output=True, text=True, env=env,
                                       check=True, timeout=45).stdout)
    matches = [item for item in listed if item.get('key') == 'WEALTHFOLIO_RECEIPT_MATCH_READ']
    if len(matches) != 1:
        raise RuntimeError('Wealthfolio read credential not uniquely available')
    secret = json.loads(subprocess.run(['/usr/local/bin/bws', 'secret', 'get',
                                       matches[0]['id'], '--output', 'json'],
                                      capture_output=True, text=True, env=env,
                                      check=True, timeout=45).stdout)
    if secret.get('key') != 'WEALTHFOLIO_RECEIPT_MATCH_READ':
        raise RuntimeError('Unexpected credential key')
    return secret['value']


def read_activities(receipts, token):
    helper = runpy.run_path('/usr/local/sbin/receipt-match-audit', run_name='finance_match')['MCP']
    mcp = helper(token)
    mcp.initialize()
    dates = sorted({date.fromisoformat(str(row['date'])[:10]) for row in receipts})
    windows = []
    for when in dates:
        start, end = when - timedelta(days=3), when + timedelta(days=3)
        if windows and start <= windows[-1][1] + timedelta(days=1):
            windows[-1] = (windows[-1][0], max(windows[-1][1], end))
        else:
            windows.append((start, end))
    if len(windows) > 1000:
        raise RuntimeError('Too many receipt date windows; review scope')
    activities = {}
    for start, end in windows:
        seen = 0
        for page in range(1, 26):
            result = mcp.call('search_activities', {
                'dateFrom': start.isoformat(), 'dateTo': end.isoformat(),
                'page': page, 'pageSize': 200})
            total = result['totalRowCount']
            if total > 5000:
                raise RuntimeError('Activity window exceeds bounded scan')
            for row in result['activities']:
                activities[row['id']] = row
            seen += len(result['activities'])
            if seen >= total:
                break
        if seen != total:
            raise RuntimeError('Incomplete activity pagination')
    return list(activities.values())


def run(apply):
    receipts = query_json(RECEIPTS_QUERY)
    existing_matches = query_json(MATCHES_QUERY)
    existing_snapshots = query_json(SNAPSHOTS_QUERY)
    if len(receipts) > 2000:
        raise RuntimeError('Receipt scope exceeds bound')
    if len({r['id'] for r in receipts}) != len(receipts):
        raise RuntimeError('Duplicate receipt IDs')
    previous = {row['receipt_id']: row for row in existing_matches}
    snapshots = {row['activity_id']: row for row in existing_snapshots}
    if len(previous) != len(existing_matches) or len(snapshots) != len(existing_snapshots):
        raise RuntimeError('Duplicate existing match or snapshot')
    activities = read_activities(receipts, credential()) if receipts else []
    selected = choose_unique_matches(receipts, activities)
    reject_stale_candidates(receipts, existing_matches, selected)
    pending = []
    counts = {'receipts': len(receipts), 'candidate': selected['candidate_count'],
              'ambiguous': selected['ambiguous_count'],
              'unmatched': selected['unmatched_count'], 'already': 0,
              'preserved': 0, 'pending': 0, 'applied': 0}
    owners = {row['activity_id']: row['receipt_id'] for row in existing_matches
              if row['activity_id']}
    for link in selected['links']:
        if link['activity_id'] in owners and owners[link['activity_id']] != link['receipt_id']:
            counts['ambiguous'] += 1
            counts['candidate'] -= 1
            continue
        state = classify_existing(previous.get(link['receipt_id']), link)
        if state == 'preserve':
            counts['preserved'] += 1
            continue
        snapshot = snapshots.get(link['activity_id'])
        if snapshot is not None and not snapshot_matches(snapshot, link):
            raise RuntimeError('Bank snapshot drift; review before writing')
        if state == 'already':
            if snapshot is None:
                raise RuntimeError('Candidate has no bank snapshot')
            counts['already'] += 1
        elif snapshot is not None:
            raise RuntimeError('Bank snapshot already owned; review before writing')
        else:
            pending.append(link)
    counts['pending'] = len(pending)
    if apply and pending:
        result = subprocess.run(analytics_write_command(), input=build_insert_script(pending),
                                capture_output=True, text=True, timeout=60)
        if result.returncode:
            raise RuntimeError('Analytics candidate write failed; inspect exact database state')
        refreshed_matches = {row['receipt_id']: row for row in query_json(MATCHES_QUERY)}
        refreshed_snapshots = {row['activity_id']: row for row in query_json(SNAPSHOTS_QUERY)}
        for link in pending:
            row = refreshed_matches.get(link['receipt_id'])
            snapshot = refreshed_snapshots.get(link['activity_id'])
            if (row is None or row['activity_id'] != link['activity_id']
                    or row['match_state'] != 'candidate' or snapshot is None
                    or not snapshot_matches(snapshot, link)):
                raise RuntimeError('Candidate readback differs; review database state')
        counts['applied'] = len(pending)
    print('receipt_match', 'apply' if apply else 'preview',
          json.dumps(counts, sort_keys=True))


def main():
    parser = argparse.ArgumentParser(description='Stage one-to-one validated receipt/bank candidates; no new expenses, no automatic confirmation.')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--preview', action='store_true', help='Read-only candidate census (default)')
    mode.add_argument('--apply', action='store_true', help='Insert only new candidate links and their bank snapshots')
    args = parser.parse_args()
    run(args.apply)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
        print('receipt_match_error', type(error).__name__, file=sys.stderr)
        raise SystemExit(1)
