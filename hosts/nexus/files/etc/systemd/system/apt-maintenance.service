[Unit]
Description=Daily APT Update, Upgrade and Cleanup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root

Environment=DEBIAN_FRONTEND=noninteractive
Environment=APT_LISTCHANGES_FRONTEND=none
Environment=NEEDRESTART_MODE=a

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

ExecStart=/usr/bin/apt-get -o APT::Update::Error-Mode=any update
ExecStart=/usr/bin/apt-get -y -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade --with-new-pkgs
ExecStart=/usr/bin/apt-get -y -o DPkg::Lock::Timeout=600 autoremove
ExecStart=/usr/bin/apt-get autoclean

StandardOutput=journal
StandardError=journal
