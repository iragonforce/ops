[Unit]
Description=Restore agent credentials from Bitwarden into volatile memory
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredentialEncrypted=bws-access-token:/etc/credstore.encrypted/bws-access-token
ExecStart=/usr/local/sbin/agent-secrets-refresh
UMask=0077
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
