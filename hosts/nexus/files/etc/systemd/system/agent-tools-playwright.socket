[Unit]
Description=Private MCP browser transport for shared Hermes

[Socket]
ListenStream=/srv/containers/data/hermes/tools/agent-tools-stage1/playwright.sock
SocketUser=iragonforce
SocketGroup=hermes-agent-tools
SocketMode=0660
DirectoryMode=0750
Accept=yes
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
