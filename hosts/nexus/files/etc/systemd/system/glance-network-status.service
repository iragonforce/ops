[Unit]
Description=Glance contextual service endpoint checks
After=docker.service tailscaled.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/containers/data/glance/config
[Service]
User=root
ReadWritePaths=/srv/containers/data/glance/config/assets
ExecStart=/usr/bin/python3 /usr/local/libexec/glance-network-status.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=192M
[Install]
WantedBy=multi-user.target
