#!/usr/bin/env python3
# Audit receipt associations using the existing data sources. See receipt-match-audit(1) for source and integration details.
"""Read-only Receipt Wrangler -> Wealthfolio candidate matching report."""

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Audit receipt associations using the existing data sources.\nUsage: receipt-match-audit \n\nSource: hosts/nexus/files/usr/local/sbin/receipt-match-audit in ~/ops\nSee man receipt-match-audit for the existing call sites and argument handling.')
        raise SystemExit(0)
import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
import unicodedata
from datetime import date, timedelta
from decimal import Decimal, InvalidOperation
from difflib import SequenceMatcher
from pathlib import Path

SECRET_ID = "09b5bf9f-a721-4584-9530-b4f901201f90"
URL = "http://127.0.0.1:18088/mcp"


def run(argv, timeout=30):
    proc = subprocess.run(argv, text=True, capture_output=True, timeout=timeout)
    if proc.returncode:
        raise RuntimeError(f"Local command failed: {Path(argv[0]).name}")
    return proc.stdout


def get_receipts():
    query = """
    SELECT json_build_object(
        'id', id, 'merchant', name, 'amount', amount::text,
        'date', to_char(date AT TIME ZONE 'UTC', 'YYYY-MM-DD')
    )::text
    FROM public.receipts
    WHERE group_id = 1
    ORDER BY id DESC LIMIT 30;
    """
    lines = run([
        "docker", "exec", "receipt-wrangler-db-1",
        "psql", "-X", "-A", "-t", "-v", "ON_ERROR_STOP=1",
        "-U", "wrangler", "-d", "wrangler", "-c", query,
    ]).splitlines()
    return [json.loads(line) for line in lines if line.strip()]


def get_token():
    wrapper = Path.home() / ".local/bin/bws"
    raw = run([
        str(wrapper), "secret", "get", SECRET_ID, "--output", "json"
    ])
    token = json.loads(raw).get("value", "").strip()
    if not token:
        raise RuntimeError("Bitwarden token missing")
    return token


class MCP:
    def __init__(self, token):
        self.token = token
        self.protocol = "2025-03-26"
        self.session = None
        self.counter = 0

    def rpc(self, method, params=None, notification=False):
        self.counter += 1
        ident = self.counter
        payload = {"jsonrpc": "2.0", "method": method}
        if not notification:
            payload["id"] = ident
        if params is not None:
            payload["params"] = params
        headers = {
            "Authorization": "Bearer " + self.token,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": self.protocol,
        }
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        req = urllib.request.Request(
            URL, data=json.dumps(payload).encode(), headers=headers, method="POST"
        )
        try:
            response = urllib.request.urlopen(req, timeout=30)
        except urllib.error.HTTPError as error:
            raise RuntimeError(f"MCP {method}: HTTP {error.code}") from None
        with response:
            self.session = response.headers.get("Mcp-Session-Id", self.session)
            if notification:
                return None
            ctype = response.headers.get("Content-Type", "")
            if "application/json" in ctype:
                answer = json.load(response)
            elif "text/event-stream" in ctype:
                answer = None
                lines = []
                total = 0
                for raw in response:
                    total += len(raw)
                    if total > 4_000_000:
                        raise RuntimeError("MCP response too large")
                    line = raw.decode("utf-8", "replace").rstrip("\r\n")
                    if line.startswith("data:"):
                        lines.append(line[5:].lstrip())
                    elif not line and lines:
                        try:
                            event = json.loads("\n".join(lines))
                        except ValueError:
                            event = None
                        lines.clear()
                        if isinstance(event, dict) and event.get("id") == ident:
                            answer = event
                            break
                if answer is None and lines:
                    try:
                        event = json.loads("\n".join(lines))
                        if event.get("id") == ident:
                            answer = event
                    except ValueError:
                        pass
            else:
                raise RuntimeError("Unexpected MCP content type")
            if not isinstance(answer, dict):
                raise RuntimeError(f"No {method} RPC reply")
            if "error" in answer:
                raise RuntimeError(f"MCP {method}: protocol error")
            return answer.get("result", {})

    def initialize(self):
        init = self.rpc("initialize", {
            "protocolVersion": self.protocol,
            "capabilities": {},
            "clientInfo": {"name": "receipt-match-audit", "version": "1.0"},
        })
        self.protocol = init.get("protocolVersion", self.protocol)
        self.rpc("notifications/initialized", notification=True)

    def call(self, name, arguments):
        result = self.rpc("tools/call", {"name": name, "arguments": arguments})
        if result.get("isError"):
            raise RuntimeError(f"{name}: tool reported an error")
        if isinstance(result.get("structuredContent"), (dict, list)):
            return result["structuredContent"]
        for part in result.get("content", []):
            if part.get("type") == "text":
                try:
                    return json.loads(part.get("text", ""))
                except ValueError:
                    continue
        return result


def rows(data):
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for name in ("activities", "transactions", "items", "results", "rows"):
            if isinstance(data.get(name), list):
                return data[name]
        for name in ("data", "result", "page"):
            if isinstance(data.get(name), (list, dict)):
                found = rows(data[name])
                if found:
                    return found
    return []


def money(value):
    try:
        return abs(Decimal(str(value))).quantize(Decimal("0.01"))
    except (InvalidOperation, ValueError, TypeError):
        return None


def normalize(value):
    raw = unicodedata.normalize("NFKD", str(value or "")).casefold()
    raw = "".join(c for c in raw if not unicodedata.combining(c))
    return " ".join(re.findall(r"[a-z0-9]+", raw))


def describe(row):
    vals = [row.get(key, "") for key in
            ("description", "name", "merchant", "payee", "notes", "symbol")]
    return " ".join(str(x) for x in vals if x).strip()


def match(receipt, activity):
    obj = activity.get("activity", activity)
    if not isinstance(obj, dict):
        return None
    amount = None
    for field in ("amount", "netAmount", "visibleSpendingAmount"):
        amount = money(obj.get(field))
        if amount is not None:
            break
    if amount is None or amount != money(receipt["amount"]):
        return None
    when = str(obj.get("date") or obj.get("activityDate") or "")[:10]
    try:
        days = abs((date.fromisoformat(when) - date.fromisoformat(receipt["date"])).days)
    except ValueError:
        return None
    if days > 7:
        return None
    a, b = normalize(receipt["merchant"]), normalize(describe(obj))
    similar = bool(a and b and (
        a in b or b in a or
        SequenceMatcher(None, a, b).ratio() >= 0.67 or
        (len(a.split()) > 0 and a.split()[0] in b.split())
    ))
    return {
        "id": obj.get("id") or obj.get("activityId") or "unknown",
        "date": when,
        "amount": str(amount),
        "description": describe(obj)[:100],
        "account": obj.get("accountId") or "unknown",
        "days": days,
        "merchant_similar": similar,
    }


def main():
    receipts = get_receipts()
    print("=== RECEIPTS ===")
    print("Records:", len(receipts))
    if not receipts:
        return
    mcp = MCP(get_token())
    mcp.initialize()
    print("MCP: PASS (read-only)")
    for receipt in receipts:
        print(f"\n=== RECEIPT {receipt['id']}: {receipt['merchant']} | "
              f"{receipt['date']} | ${receipt['amount']} ===")
        day = date.fromisoformat(receipt["date"])
        start = (day - timedelta(days=7)).isoformat()
        end = (day + timedelta(days=7)).isoformat()
        sources = [
            ("activities", "search_activities", {
                "dateFrom": start, "dateTo": end,
                "page": 1, "pageSize": 100,
            }),
            ("spending", "search_spending_transactions", {
                "startDate": start + "T00:00:00Z",
                "endDate": end + "T23:59:59Z",
                "limit": 100, "offset": 0,
            }),
        ]
        seen = set()
        potential = []
        incomplete = False
        for label, name, args in sources:
            try:
                data = mcp.call(name, args)
                records = rows(data)
                print(f"{label}: {len(records)} rows returned")
                if len(records) >= 100:
                    incomplete = True
                    print(f"{label}: PAGE LIMIT REACHED; results incomplete")
                for row in records:
                    if not isinstance(row, dict):
                        continue
                    candidate = match(receipt, row)
                    if candidate:
                        key = (str(candidate["id"]), candidate["date"])
                        if key not in seen:
                            seen.add(key)
                            potential.append(candidate)
            except Exception as error:
                incomplete = True
                print(f"{label}: ERROR {error}")
        potential.sort(key=lambda x: (not x["merchant_similar"], x["days"]))
        if incomplete:
            print("Result: INCOMPLETE (review returned candidates, do not finalize)")
        elif not potential:
            print("Result: UNMATCHED (searched ±7 days)")
        elif len(potential) == 1 and potential[0]["merchant_similar"] and potential[0]["days"] <= 3:
            print("Result: LIKELY MATCH (requires confirmation)")
        else:
            print("Result: REVIEW")
        for candidate in potential[:10]:
            print(json.dumps(candidate, ensure_ascii=False))
        if len(potential) > 10:
            print(f"Additional candidates: {len(potential) - 10}")
    print("\nDatabase writes: NONE | Wealthfolio writes: NONE")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"ERROR: {type(error).__name__}: {error}", file=sys.stderr)
        sys.exit(1)
