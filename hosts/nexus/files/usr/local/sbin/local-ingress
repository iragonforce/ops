#!/usr/bin/env python3

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Configure existing local ingress; supports its existing wait behavior.\nUsage: local-ingress  [ARGUMENT ...]\n\nSource: hosts/nexus/files/usr/local/sbin/local-ingress in ~/ops\nSee man local-ingress for the existing call sites and argument handling.')
        raise SystemExit(0)
# Configure existing local ingress; supports its existing wait behavior. See local-ingress(1) for source and integration details.
import json,pathlib,sqlite3,subprocess,sys,time,os
if '--wait' in sys.argv:
    for attempt in range(180):
        j=json.loads(subprocess.check_output(['ip','-j','addr','show']))
        ips={a['local'] for i in j for a in i.get('addr_info',[])}
        if {'192.168.1.2','100.96.255.81'} <= ips:break
        time.sleep(1)
    else:sys.exit('Nexus ingress addresses unavailable; infrastructure startup stopped.')
db=pathlib.Path('/srv/containers/data/nginx/data/database.sqlite')
if not db.exists():sys.exit('NPM data mount missing; keeping previous hosts file.')
c=sqlite3.connect('file:'+str(db)+'?mode=ro',uri=True)
domains={d for row in c.execute('SELECT domain_names FROM proxy_host WHERE is_deleted=0 AND enabled=1') for d in json.loads(row[0]) if d=='blinkwired.com' or d.endswith('.blinkwired.com')}
assert all('\n' not in d and ' ' not in d for d in domains)
p=pathlib.Path('/etc/hosts');s=p.read_text();begin='# BEGIN NEXUS LOCAL INGRESS';end='# END NEXUS LOCAL INGRESS'
if begin in s and end in s:s=s[:s.index(begin)]+s[s.index(end)+len(end):]
new=s.rstrip()+'\n\n'+begin+'\n'+''.join('192.168.1.2 '+d+'\n' for d in sorted(domains))+end+'\n'
if p.read_text()!=new:
    stat=p.stat();tmp=p.with_name('.hosts.nexus.tmp');tmp.write_text(new);os.chown(tmp,stat.st_uid,stat.st_gid);tmp.chmod(stat.st_mode&0o777);os.replace(tmp,p)
print('Nexus local ingress names synchronized:',len(domains))
