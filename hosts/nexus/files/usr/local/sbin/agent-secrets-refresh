#!/usr/bin/python3
# Resolve approved Bitwarden bindings into volatile runtime credential files. See agent-secrets-refresh(1) for source and integration details.
"""Fetch agent credentials into volatile storage. Never print secret material."""

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Resolve approved Bitwarden bindings into volatile runtime credential files.\nUsage: agent-secrets-refresh \n\nSource: hosts/nexus/files/usr/local/sbin/agent-secrets-refresh in ~/ops\nSee man agent-secrets-refresh for the existing call sites and argument handling.')
        raise SystemExit(0)
import os,json,subprocess,pathlib,tempfile
try:
 token=(pathlib.Path(os.environ['CREDENTIALS_DIRECTORY'])/'bws-access-token').read_text().strip()
 rows=json.loads(subprocess.check_output(['/usr/local/bin/bws','secret','list'],env={**os.environ,'BWS_ACCESS_TOKEN':token},stderr=subprocess.DEVNULL,text=True,timeout=90))
 values={s['id']:s['value'] for s in rows};refs=json.loads(pathlib.Path('/etc/agent-secrets/refs.json').read_text())
 directory=pathlib.Path('/run/agent-credentials');directory.mkdir(mode=0o750,exist_ok=True);os.chown(directory,0,10000);os.chmod(directory,0o750)
 lines=[]
 for name,sid in refs['env'].items():
  value=values[sid]
  if '\n' in value or '\r' in value:raise ValueError('Multiline environment credential requires a file binding')
  lines.append(name+'='+value)
 fd,tmp=tempfile.mkstemp(dir=directory);os.fchmod(fd,0o640);os.fchown(fd,0,10000)
 with os.fdopen(fd,'w') as f:f.write('\n'.join(lines)+'\n')
 os.replace(tmp,directory/'hermes.env')
 print('Agent credentials loaded into volatile storage; bindings='+str(len(lines)))
 if subprocess.run(['systemctl','is-active','--quiet','docker.service']).returncode==0:
  subprocess.run(['docker','restart','hermes'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=60,check=True)
except Exception as exc:
 print('Agent credential retrieval failed: '+type(exc).__name__);raise SystemExit(1)
