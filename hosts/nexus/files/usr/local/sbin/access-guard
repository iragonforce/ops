#!/usr/bin/env python3

if __name__ == "__main__":
    import sys as _ops_sys
    if _ops_sys.argv[1:] == ["--help"]:
        print('Manage the existing guarded access change and rollback workflow.\nUsage: access-guard  [ARGUMENT ...]\n\nSource: hosts/nexus/files/usr/local/sbin/access-guard in ~/ops\nSee man access-guard for the existing call sites and argument handling.')
        raise SystemExit(0)
# Manage the existing guarded access change and rollback workflow. See access-guard(1) for source and integration details.
import json,os,pathlib,subprocess,sys
os.umask(0o077)
STATE=pathlib.Path('/var/lib/nexus-network-20261012')
def run(*a):
 p=subprocess.run(a,capture_output=True,text=True)
 if p.returncode:
  (STATE/'guard-error.txt').write_text(p.stderr)
  raise RuntimeError('Firewall command failed; private diagnostic saved')
 return p.stdout
def exists(family,name):return subprocess.run(['/usr/sbin/nft','list','table',family,name],capture_output=True).returncode==0
def rollback():
 for family,name in [('inet','nexus_host_guard'),('bridge','nexus_proxy_guard')]:
  if exists(family,name):run('/usr/sbin/nft','delete','table',family,name)
 print('Network guard removed; existing Docker and NFS rules retained')
def host():
 text=pathlib.Path('/etc/nexus/host-access.nft').read_text()
 if exists('inet','nexus_host_guard'):text='delete table inet nexus_host_guard\n'+text
 p=STATE/'host-access-apply.nft';p.write_text(text);p.chmod(0o600)
 run('/usr/sbin/nft','-c','-f',str(p));run('/usr/sbin/nft','-f',str(p))
def refresh():
 ids=run('docker','ps','-q').split()
 if not ids:return
 cs=json.loads(run('docker','inspect',*ids))
 net=json.loads(run('docker','network','inspect','proxy-backend'))[0]
 bridge='br-'+net['Id'][:12]
 groups={2:[],3:[],4:[],5:[]};byname={}
 for c in cs:
  name=c['Name'].lstrip('/');nets=c['NetworkSettings']['Networks']
  ip=nets.get('proxy-backend',{}).get('IPAddress')
  vlan=next((v for v,n in [(2,'pia-vlan'),(3,'adguard-vlan'),(4,'iot-vlan'),(5,'docker-vlan')] if n in nets),None)
  if ip and vlan:groups[vlan].append(ip);byname[name]=ip
 text=''
 for family,name in [('inet','nexus_host_guard'),('bridge','nexus_proxy_guard')]:
  if exists(family,name):text+=f'delete table {family} {name}\n'
 text+='''table inet nexus_host_guard {
 chain input {
  type filter hook input priority -30; policy accept;
  iifname "lo" accept
  ct state established,related accept
  ip saddr {192.168.1.3, 192.168.1.4, 192.168.1.102, 192.168.1.154, 100.103.67.56, 100.114.178.50, 100.124.58.43} tcp dport 22 accept
  ip6 saddr { fd7a:115c:a1e0::9639:4338, fd7a:115c:a1e0::ed39:b232 } tcp dport 22 accept
  iifname "br-c231b5e7ed74" ip saddr 172.30.240.100 tcp dport 22 accept
  iifname "nexus-mv5" ip saddr 192.168.5.55 ip daddr 192.168.5.254 tcp dport 22 accept
  tcp dport 22 counter drop
  ip saddr { 192.168.1.3, 192.168.1.4, 192.168.1.5, 192.168.1.102, 192.168.1.6, 100.103.67.56, 100.114.178.50 } tcp dport { 139, 445 } accept
  ip6 saddr { fd7a:115c:a1e0::9639:4338, fd7a:115c:a1e0::ed39:b232 } tcp dport { 139, 445 } accept
  tcp dport { 139, 445 } counter drop
 }
}
table bridge nexus_proxy_guard {
'''
 for v,addresses in groups.items():
  text+=f' set vlan{v} {{ type ipv4_addr; '
  if addresses:text+='elements = { '+', '.join(sorted(addresses))+' }; '
  text+='}\n'
 # Checkmk's forced-command SSH collector; no general Docker SSH permission.
 if 'checkmk' in byname:
  text=text.replace('  tcp dport 22 counter drop\n', f'  iifname "{bridge}" ip saddr {byname["checkmk"]} ip daddr 172.16.11.1 tcp dport 22 accept\n  tcp dport 22 counter drop\n', 1)
 text+=' chain forward {\n  type filter hook forward priority -150; policy accept;\n'
 text+=f'  meta ibrname "{bridge}" ct state established,related accept\n'
 if 'nginx-proxy-manager' in byname:text+=f'  meta ibrname "{bridge}" ip saddr {byname["nginx-proxy-manager"]} accept\n'
 for source,target,port in [('seerr','sonarr',30113),('seerr','radarr',30025),('hermes','home-assistant',30103)]:
  if source in byname and target in byname:text+=f'  meta ibrname "{bridge}" ip saddr {byname[source]} ip daddr {byname[target]} tcp dport {port} accept\n'
 if 'adguard-home' in byname:text+=f'  meta ibrname "{bridge}" ip daddr {byname["adguard-home"]} meta l4proto {{ tcp, udp }} th dport 53 accept\n'
 for a in groups:
  for b in groups:
   if a!=b:text+=f'  meta ibrname "{bridge}" ip saddr @vlan{a} ip daddr @vlan{b} counter drop\n'
 text+=' }\n}\n'
 path=STATE/'guard-current.nft';path.write_text(text);path.chmod(0o600)
 run('/usr/sbin/modprobe','nf_conntrack_bridge')
 run('/usr/sbin/nft','-c','-f',str(path));run('/usr/sbin/nft','-f',str(path))
def install():
 target=pathlib.Path('/usr/local/sbin/access-guard');target.write_text(pathlib.Path(__file__).read_text());target.chmod(0o700)
 p=pathlib.Path('/etc/systemd/system/access-guard.service');p.write_text('''[Unit]
Description=Nexus host and Docker proxy bridge access controls
After=docker.service vlans.service
Wants=docker.service
Before=nfs-server.service smbd.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/access-guard refresh
''');p.chmod(0o644)
 p=pathlib.Path('/etc/systemd/system/access-guard.timer');p.write_text('''[Unit]
Description=Refresh Nexus access rules after container recreation
[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
Unit=access-guard.service
[Install]
WantedBy=timers.target
''');p.chmod(0o644)
 run('systemctl','daemon-reload')
 run('systemd-run','--unit=network-guard-rollback','--on-active=180s','/usr/local/sbin/access-guard','rollback')
 refresh()
 print('Access guard applied; rollback timer armed')
def commit():
 subprocess.run(['systemctl','stop','network-guard-rollback.timer'],capture_output=True)
 run('systemctl','enable','--now','access-guard.timer')
 # Host protection starts before SSH/file servers; bridge refresh follows Docker.
 full=(STATE/'guard-current.nft').read_text()
 text=full[full.index('table inet nexus_host_guard {'):full.index('table bridge nexus_proxy_guard {')]
 p=pathlib.Path('/etc/nexus/host-access.nft');p.write_text(text);p.chmod(0o600)
 p=pathlib.Path('/etc/systemd/system/host-access.service');p.write_text('''[Unit]
Description=Nexus early boot SSH and SMB restrictions
DefaultDependencies=no
After=local-fs.target
Before=ssh.service ssh.socket smbd.service nfs-server.service
Conflicts=shutdown.target
Before=shutdown.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/access-guard host
[Install]
WantedBy=multi-user.target
''');p.chmod(0o644)
 run('systemctl','daemon-reload');run('systemctl','enable','--now','host-access.service')
 p=pathlib.Path('/etc/samba/smb.conf');s=p.read_text()
 s='\n'.join(' hosts allow = 127.0.0.1 192.168.1.3 192.168.1.4 192.168.1.5 192.168.1.102 192.168.1.6 100.103.67.56 100.114.178.50' if line.strip().startswith('hosts allow =') else line for line in s.splitlines())+'\n'
 p.write_text(s);p.chmod(0o644)
 run('/usr/bin/testparm','-s');run('systemctl','reload','smbd.service')
 print('Access guard persisted; SMB allowlist includes approved Windows PC')
if __name__=='__main__':
 try:{'refresh':refresh,'install':install,'commit':commit,'rollback':rollback,'host':host}[sys.argv[1]]()
 except Exception as e:print('Stopped:',str(e));sys.exit(1)
