        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor-nexus\",name!=\"\"}[$__rate_interval]))",
