{
  "uid": "nexus-docker-containers",
  "title": "Nexus — Docker Containers",
  "tags": [
    "nexus",
    "docker",
    "cadvisor",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "afgt2mp7n1wxse"
        },
        "query": "label_values(container_memory_working_set_bytes{job=\"cadvisor-nexus\",name!=\"\"}, name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observed containers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(container_memory_working_set_bytes{job=\"cadvisor-nexus\",name!=\"\"})",
          "legendFormat": "Containers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Container CPU cores used",
      "type": "stat",
      "datasource": {
