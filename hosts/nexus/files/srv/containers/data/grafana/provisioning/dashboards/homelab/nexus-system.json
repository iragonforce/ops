{
  "uid": "nexus-system-overview",
  "title": "Nexus — System Overview",
  "tags": [
    "nexus",
    "system",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "CPU utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"nexus\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "RAM utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"nexus\"} / node_memory_MemTotal_bytes{instance=\"nexus\"})",
          "legendFormat": "RAM",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Root filesystem used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"nexus\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=\"nexus\",mountpoint=\"/\"})",
          "legendFormat": "/",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Swap used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "node_memory_SwapTotal_bytes{instance=\"nexus\"} - node_memory_SwapFree_bytes{instance=\"nexus\"}",
          "legendFormat": "Swap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "CPU by logical core",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - rate(node_cpu_seconds_total{instance=\"nexus\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "CPU {{cpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Memory used / available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{instance=\"nexus\"} - node_memory_MemAvailable_bytes{instance=\"nexus\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{instance=\"nexus\"}",
          "legendFormat": "Available",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Physical disk throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{instance=\"nexus\",device=~\"nvme0n1|sd[a-c]\"}[$__rate_interval])",
          "legendFormat": "Read {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{instance=\"nexus\",device=~\"nvme0n1|sd[a-c]\"}[$__rate_interval])",
          "legendFormat": "Write {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Physical disk IOPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_disk_reads_completed_total{instance=\"nexus\",device=~\"nvme0n1|sd[a-c]\"}[$__rate_interval])",
          "legendFormat": "Read {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_writes_completed_total{instance=\"nexus\",device=~\"nvme0n1|sd[a-c]\"}[$__rate_interval])",
          "legendFormat": "Write {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "ZFS filesystem utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (mountpoint) (100 * (1 - node_filesystem_avail_bytes{instance=\"nexus\",fstype=\"zfs\",mountpoint=~\"/mnt/(fast|bulk)\"} / node_filesystem_size_bytes{instance=\"nexus\",fstype=\"zfs\",mountpoint=~\"/mnt/(fast|bulk)\"}))",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Physical Ethernet throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "8 * rate(node_network_receive_bytes_total{instance=\"nexus\",device=\"enp6s0\"}[$__rate_interval])",
          "legendFormat": "RX",
          "refId": "A"
        },
        {
          "expr": "8 * rate(node_network_transmit_bytes_total{instance=\"nexus\",device=\"enp6s0\"}[$__rate_interval])",
          "legendFormat": "TX",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Ethernet errors and drops / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_errs_total{instance=\"nexus\",device=\"enp6s0\"}[$__rate_interval])",
          "legendFormat": "RX errors",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_receive_drop_total{instance=\"nexus\",device=\"enp6s0\"}[$__rate_interval])",
          "legendFormat": "RX drops",
          "refId": "B"
        },
        {
          "expr": "rate(node_network_transmit_errs_total{instance=\"nexus\",device=\"enp6s0\"}[$__rate_interval])",
          "legendFormat": "TX errors",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Load average",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afgt2mp7n1wxse"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_load1{instance=\"nexus\"}",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "node_load5{instance=\"nexus\"}",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "node_load15{instance=\"nexus\"}",
          "legendFormat": "15m",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
