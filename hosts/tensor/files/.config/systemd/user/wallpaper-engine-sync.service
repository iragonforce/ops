[Unit]
Description=Mirror Wallpaper Engine selections onto Hyprland monitors (GPU-lease guarded)

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /home/iragonforce/.local/lib/tensor-gpu/tensor-gpu-wallpaper-systemd.py --serve
