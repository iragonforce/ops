#!/usr/bin/python3
# Connect SSH to the configured host endpoint, retaining the existing route policy. See homelab-ssh-connect(1) for source and integration details.
"""Proxy an SSH TCP stream through LAN first, then Tailscale."""
import argparse
import os
import socket
import sys
import threading

ENDPOINTS = {
    "qubit": ("192.168.1.4", "100.103.67.56"),
    "tensor": ("192.168.1.3", "100.114.178.50"),
    "nexus": ("192.168.1.2", "100.96.255.81"),
}
TIMEOUT = 5


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("host", choices=ENDPOINTS)
    parser.add_argument("port", type=int)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("port must be in 1..65535")

    stream = None
    errors = []
    for route, address in zip(("LAN", "Tailscale"), ENDPOINTS[args.host]):
        try:
            stream = socket.create_connection((address, args.port), TIMEOUT)
            stream.settimeout(None)
            if args.verbose:
                print(f"homelab-ssh: {args.host}: {route} {address}:{args.port}", file=sys.stderr)
            break
        except OSError as exc:
            errors.append(f"{route} {address}:{args.port}: {exc}")
            if args.verbose:
                print(f"homelab-ssh: {errors[-1]}", file=sys.stderr)
    if stream is None:
        print("homelab-ssh: " + "; ".join(errors), file=sys.stderr)
        return 1

    def upload():
        try:
            while data := os.read(0, 65536):
                stream.sendall(data)
        except OSError:
            pass
        finally:
            try:
                stream.shutdown(socket.SHUT_WR)
            except OSError:
                pass

    threading.Thread(target=upload, daemon=True).start()
    try:
        while data := stream.recv(65536):
            view = memoryview(data)
            while view:
                view = view[os.write(1, view):]
    except OSError as exc:
        print(f"homelab-ssh: stream ended: {exc}", file=sys.stderr)
        return 1
    finally:
        stream.close()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
